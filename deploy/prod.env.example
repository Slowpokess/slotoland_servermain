# Production environment template.
# Copy this file to deploy/prod.env and fill in real values.

SLOTOPOL_PG_DB=slotopol
SLOTOPOL_PG_USER=slotopol
SLOTOPOL_PG_PASSWORD=change-me

SLOTOPOL_DBDRIVER=postgres
SLOTOPOL_CLUBDSN=host=postgres port=5432 user=slotopol password=change-me dbname=slotopol sslmode=disable
SLOTOPOL_SPINDSN=host=postgres port=5432 user=slotopol password=change-me dbname=slotopol sslmode=disable

SLOTOPOL_ACCESS_KEY=change-me-access-key
SLOTOPOL_REFRESH_KEY=change-me-refresh-key
SLOTOPOL_BREVO_API_KEY=
